---
# Copy this file to inventory/group_vars/vault.yml and encrypt the copy with
# Ansible Vault. These values are placeholders and must never be used in a
# live deployment.
vault_mysql_replication_password: "REPLACE_WITH_A_LONG_RANDOM_PASSWORD"
vault_mysql_metrics_password: "REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_PASSWORD"
vault_grafana_admin_password: "REPLACE_WITH_A_LONG_RANDOM_PASSWORD"

# Alertmanager SMTP settings. Use an application-specific SMTP password where
# the mail provider supports it.
vault_alert_email: "alerts@example.invalid"
vault_smtp_smarthost: "smtp.example.invalid:587"
vault_smtp_username: "REPLACE_WITH_SMTP_USERNAME"
vault_smtp_password: "REPLACE_WITH_SMTP_PASSWORD"
